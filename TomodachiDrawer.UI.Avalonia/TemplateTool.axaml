<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:strings="clr-namespace:TomodachiDrawer.UI.Avalonia"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="TomodachiDrawer.UI.Avalonia.TemplateTool"
		Title="Template Tool"
		Width="800" Height="675"
		MinWidth="800" MinHeight="675"
		>
	<Window.Styles>
		<Style Selector="Border.group">
			<Setter Property="BorderBrush" Value="#55888888" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="8" />
		</Style>
		<Style Selector="TextBlock.header">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
	</Window.Styles>
	<Grid Margin="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="290" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Border Grid.Row="0" Classes="group" Margin="0,0,0,6">
				<StackPanel Spacing="6">
					<TextBlock Classes="header" Text="{x:Static strings:Strings.TemplateTool_Information_Header}" />
					<TextBlock TextWrapping="Wrap" Text="{x:Static strings:Strings.TemplateTool_Information_Intro}" />
					<TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{x:Static strings:Strings.TemplateTool_Information_StepsHeader}" />
					<StackPanel Spacing="4" Margin="8,0,0,0">
						<TextBlock TextWrapping="Wrap" Text="{x:Static strings:Strings.TemplateTool_Information_Step1}" />
						<TextBlock TextWrapping="Wrap" Text="{x:Static strings:Strings.TemplateTool_Information_Step2}" />
						<TextBlock TextWrapping="Wrap" Text="{x:Static strings:Strings.TemplateTool_Information_Step3}" />
						<TextBlock TextWrapping="Wrap" Text="{x:Static strings:Strings.TemplateTool_Information_Step4}" />
					</StackPanel>
					<TextBlock TextWrapping="Wrap" FontWeight="Normal" >
						<Run Text="{x:Static strings:Strings.TemplateTool_Information_DisplayScaleNote}"/>
						<LineBreak/>
						<InlineUIContainer>
							<HyperlinkButton Content="{x:Static strings:Strings.TemplateTool_Information_DisplayScaleNote_Link}" NavigateUri="https://github.com/Lucas7yoshi/TomodachiDrawer/issues/64" Padding="0" BorderThickness="0" FontWeight="Light" />
						</InlineUIContainer>
					</TextBlock>
				</StackPanel>
			</Border>
			<Border Grid.Row="1" Classes="group" Margin="0,0,0,6">
				<StackPanel Spacing="6">
					<TextBlock Classes="header" Text="{x:Static strings:Strings.TemplateTool_Options_Header}" />
					<Button x:Name="CopyClipboardButton" Content="{x:Static strings:Strings.TemplateTool_CopyClipboardButton}" HorizontalAlignment="Stretch" Click="CopyClipboardButton_Click" />
					<Button x:Name="SaveTemplateButton" Content="{x:Static strings:Strings.TemplateTool_SaveTemplateButton}" HorizontalAlignment="Stretch" Click="SaveTemplateButton_Click" ToolTip.Tip="{x:Static strings:Strings.TemplateTool_SaveTemplateButton_Tooltip}" />
					<Button x:Name="PasteButton" Content="{x:Static strings:Strings.TemplateTool_PasteButton}" HorizontalAlignment="Stretch" Click="PasteButton_Click" />
					<Button x:Name="OpenDrawingButton" Content="{x:Static strings:Strings.TemplateTool_OpenDrawingButton}" HorizontalAlignment="Stretch" Click="OpenDrawingButton_Click" ToolTip.Tip="{x:Static strings:Strings.TemplateTool_OpenDrawingButton_Tooltip}" />
					<Separator />
					<Grid ColumnDefinitions="*,6,*">
						<Button x:Name="ConfirmButton" Grid.Column="0" Content="{x:Static strings:Strings.TemplateTool_ConfirmButton}" HorizontalAlignment="Stretch" Click="ConfirmButton_Click" IsEnabled="False"/>
						<Button x:Name="ExitButton" Grid.Column="2" Content="{x:Static strings:Strings.TemplateTool_ExitButton}" HorizontalAlignment="Stretch" Click="ExitButton_Click" />
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
		<Border Grid.Column="1" Classes="group" Margin="6,0,0,0">
			<Panel>
				<Image x:Name="CheckerboardPreview"
					   Stretch="Uniform"
					   RenderOptions.BitmapInterpolationMode="None" />
				<Image x:Name="TemplatePreview"
					   Stretch="Uniform"
					   RenderOptions.BitmapInterpolationMode="None" />
			</Panel>
		</Border>
	</Grid>
</Window>
