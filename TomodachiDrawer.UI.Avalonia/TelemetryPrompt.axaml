<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:strings="clr-namespace:TomodachiDrawer.UI.Avalonia"
		x:Class="TomodachiDrawer.UI.Avalonia.TelemetryPrompt"
		Title="{x:Static strings:Strings.TelemetryPrompt_Title}"
		Width="420"
		MinWidth="420" MinHeight="240"
		CanResize="False"
		SizeToContent="Height"
		WindowStartupLocation="CenterOwner">

	<StackPanel Margin="16" Spacing="12">
		<TextBlock FontWeight="SemiBold" FontSize="15" Text="{x:Static strings:Strings.TelemetryPrompt_Header}" />
		<TextBlock TextWrapping="Wrap"
				   Text="{x:Static strings:Strings.TelemetryPrompt_Description}"
				   />

		<Expander Header="{x:Static strings:Strings.TelemetryPrompt_ExpanderHeader}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
			<StackPanel Spacing="2" Margin="4,4,0,4">
				<TextBlock FontWeight="SemiBold" Text="{x:Static strings:Strings.TelemetryPrompt_OnStartup_Header}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnStartup_OS}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnStartup_CPU}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnStartup_AppVersion}" />
				<TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_Header}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_Dimensions}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_ColourCount}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_QuantizerMode}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_SwitchVersion}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_ExperimentalEnabled}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_DrawTimeEstimate}" />
				<TextBlock Text="{x:Static strings:Strings.TelemetryPrompt_OnExport_TSPTimeLimit}" />
			</StackPanel>
		</Expander>

		<TextBlock
				FontWeight="Bold" TextDecorations="Underline"
				Text="{x:Static strings:Strings.TelemetryPrompt_ImagesNeverUploaded}"
				/>
		<TextBlock FontStyle="Italic" Text="{x:Static strings:Strings.TelemetryPrompt_ChangeMindLater}"/>

		<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
			<Button x:Name="SureButton" FontWeight="SemiBold" Click="SureButton_Click"
					Background="#2E7D32" Foreground="White">
				<TextBlock
						FontWeight="SemiBold"
						Text="{x:Static strings:Strings.TelemetryPrompt_SureButton}"
						TextDecorations="Underline"
					/>
			</Button>
			<Button x:Name="NoThanksButton" Content="{x:Static strings:Strings.TelemetryPrompt_NoThanksButton}" Click="NoThanksButton_Click"
					Background="#C62828" Foreground="White" />
			<Button x:Name="OpenSourceButton" Content="{x:Static strings:Strings.TelemetryPrompt_ViewSourceButton}" Click="OpenSourceButton_Click"
					Background="#1565C0" Foreground="White" />
		</StackPanel>
	</StackPanel>

</Window>
