<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:TomodachiDrawer.UI.Avalonia"
		x:Class="TomodachiDrawer.UI.Avalonia.MainWindow"
		Icon="/Assets/Icon.png"
		Title="Tomodachi Drawer"
		Width="1100" Height="700"
		MinWidth="875" MinHeight="600">
	<!-- KEEP WINDOW SIZE < 1280x720, with smaller mins preferred -->

	<Window.Styles>
		<Style Selector="Border.group">
			<Setter Property="BorderBrush" Value="#55888888" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Padding" Value="8" />
		</Style>
		<Style Selector="TextBlock.header">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>
		<Style Selector="TabItem">
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="FontSize" Value="22" />
			<Setter Property="Padding" Value="8, 4" />
			<Setter Property="Margin" Value="0" />
		</Style>
	</Window.Styles>
	<DockPanel>
		<Menu x:Name="Menu" DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem x:Name="MenuExportTDLD"
						  Header="_Export to .tdld..."
						  IsEnabled="False"
						  ToolTip.Tip="Saves the raw .tdld binary macro file. Useful for other firmware implementations created by others (Like the Flipper Zero) or debugging."
						  Click="ExportTDLDButton_Click"/>
				<MenuItem Header="_Save Preview..." Click="MenuSavePreview_Click"/>
				<Separator/>
				<MenuItem Header="_Exit" Click="MenuExit_Click"/>
			</MenuItem>
			<MenuItem Header="_Settings" StaysOpenOnClick="True">
				<MenuItem
				x:Name="CheckForUpdatesCheckBox"
				Header="_Check For Updates On Start"
				ToggleType="CheckBox"
				Click="CheckForUpdatesCheckBox_Click"
				/>
				<MenuItem Header="_Theme">
					<MenuItem x:Name="ThemeSystemMenuItem" Header="_Match System" ToggleType="CheckBox" IsChecked="True" Click="ThemeMenuItem_Click"/>
					<MenuItem x:Name="ThemeLightMenuItem" Header="_Light" ToggleType="CheckBox" Click="ThemeMenuItem_Click"/>
					<MenuItem x:Name="ThemeDarkMenuItem" Header="_Dark" ToggleType="CheckBox" Click="ThemeMenuItem_Click"/>
				</MenuItem>
				<MenuItem
				x:Name="EnableExperimentalMenuItem"
				Header="_Enable Experimental Features"
				ToggleType="CheckBox"
				Click="EnableExperimentalMenuItem_Click"
				/>
				<MenuItem
				x:Name="EarlyTspExitMenuItem"
				Header="Early TSP _Convergence..."
				Click="EarlyTspExitMenuItem_Click"
				ToolTip.Tip="Lets the TSP solver exit early if it believes theres very minimal gain to be had, even in worst case having this off saves only seconds in the end result, but speeds up export. Opens the tuning knobs."
				/>
				<MenuItem
				x:Name="OpenTelemetryPrompt"
				Header="_Open Telemetry Prompt"
				Click="OpenTelemetryPrompt_Click"
				/>
				<MenuItem
				x:Name="ReverseColourOrder"
				Header="_Reverse Colour Order"
				ToolTip.Tip="Reverses the order the program processess colours in. This is mostly intended as a bandaid for Switch 1 users to try and complete drawings that desync. This may not be 100% consistent, unless you use the exact same settings."
				ToggleType="CheckBox"
				Click="ReverseColourOrder_Click"
				/>
			</MenuItem>
			<MenuItem Header="_Templates" x:Name="MenuTemplates">
				<!-- Inserted at runtime -->
			</MenuItem>
			<MenuItem Header="_Tools">
				<MenuItem x:Name="MenuToolsOpenColourToHSVStepsTool"
						  Header="_Convert Colour to HSV Steps"
						  Click="MenuToolsOpenColourToHSVStepsTool_Click" />
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem
				x:Name="MenuHelpOpenGitHub"
				Header="_Open GitHub Repo"
				Click="MenuHelpOpenGitHub_Click"
				/>
				<MenuItem
				x:Name="MenuHelpOpenWelcome"
				Header="_Show Welcome Again"
				Click="MenuHelpOpenWelcome_Click"
				/>
				<MenuItem
				x:Name="MenuHelpCheckForUpdate"
				Header="Check For Update"
				Click="MenuHelpCheckForUpdate_Click"
				/>
				<MenuItem
				Header="_Setup Explanation"
				Click="OutputExplanationButton_Click"
				/>
				<MenuItem
				Header="_In-Game Setup Info"
				Click="InGameSetupButton_Click"
				/>
				<Separator/>
				<MenuItem
				x:Name="MenuHelpAbout"
				Header="_About"
				Click="MenuHelpAbout_Click"
				/>
			</MenuItem>
		</Menu>
		<Grid Margin="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="375" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid Grid.Column="0" Margin="0,0,6,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0" Classes="group" Margin="0,0,0,6">
					<StackPanel Spacing="6">
						<TextBlock Classes="header" Text="Input Image" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBox Grid.Column="0"
									 x:Name="ImagePathBox"
									 IsReadOnly="True"
									 PlaceholderText="No image loaded…" />
							<Button Grid.Column="1"
									Content="Open..."
									Margin="4,0,0,0"
									Click="OpenImageButton_Click" />
						</Grid>
					</StackPanel>
				</Border>
				<Border Grid.Row="1" Classes="group" Margin="0,0,0,6">
					<StackPanel Spacing="6">
						<TextBlock Classes="header" Text="Routing" />
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
							<TextBlock Grid.Column="0"
									   Text="Switch Compatibility:"
									   VerticalAlignment="Center" />
							<ComboBox Grid.Column="1"
									  x:Name="SwitchVersionComboBox"
									  SelectionChanged="SwitchVersionComboBox_SelectionChanged"
									  HorizontalAlignment="Stretch"
									  PlaceholderText="SELECT YOUR SWITCH!">
								<ComboBoxItem>Switch 1/Lite/OLED</ComboBoxItem>
								<ComboBoxItem>Switch 2</ComboBoxItem>
							</ComboBox>
						</Grid>
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="TSP Solver Time Limit"
									   VerticalAlignment="Center" />
							<!-- TODO: revert to NumericUpDown once Avalonia#21491 is fixed -->
							<local:SafeNumericUpDown x:Name="TSPTimeLimitUpDown"
										   Minimum="0.1" Maximum="30"
										   Increment="0.1" Value="0.5"
											Width="110" />
							<TextBlock Text="seconds"
									   VerticalAlignment="Center" />
							<Button Content="?"
									Width="28"
									Click="TSPHelpButton_Click" />
						</StackPanel>
						<CheckBox x:Name="EnableHomeCanvas"
								  Content="Auto Home Canvas To Top Left (Resets canvas)"
								  ToolTip.Tip="At the beginning, the program will zoom out, and set itself at the very very top left of the canvas. This is automatically checked for full size (256x256) images. Additionally, to ensure the bucket tool works for Switch 2 it will clear the canvas."
								  IsCheckedChanged="EnableHomeCanvas_IsCheckedChanged"
								  />
					</StackPanel>
				</Border>
				<Border Grid.Row="2" Classes="group" Margin="0,0,0,6">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top"
								   Classes="header"
								   Text="Log" />
						<TextBox x:Name="LogBox"
								 IsReadOnly="True"
								 AcceptsReturn="True"
								 TextWrapping="Wrap"
								 ScrollViewer.VerticalScrollBarVisibility="Auto" />
					</DockPanel>
				</Border>
				<DockPanel Grid.Row="3" Margin="2,0,2,6">
					<Button DockPanel.Dock="Right"
							x:Name="CancelDrawButton"
							Content="Cancel Draw"
							IsEnabled="False"
							ToolTip.Tip="Cancels the image draw generation currently in progress."
							VerticalAlignment="Center"
							Click="CancelDrawButton_Click" />
					<TextBlock x:Name="DrawTimeLabel"
							   Text="Draw Time Estimate: ???"
							   ToolTip.Tip="This is a generally very accurate estimate as to how long the drawing will take, including all actions."
							   FontSize="17"
							   FontWeight="Bold"
							   VerticalAlignment="Center" />
				</DockPanel>
				<Border Grid.Row="4" Classes="group">
					<TabControl x:Name="ChipTabControl">
						<TabItem x:Name="RP2040Tab" Header="RP2040">
							<StackPanel Spacing="5" Margin="0,4,0,0">
								<TextBlock x:Name="RP2040StatusLabel" Text="RP2040: Not Found" />
								<Grid ColumnDefinitions="*,*">
									<Button Grid.Column="0"
											x:Name="RP2040FlashButton"
											IsEnabled="False"
											Content="Flash Base Firmware"
											ToolTip.Tip="Flash the firmware that reads drawing data from the RP2040's flash."
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="FlashFirmwareButton_Click" />
									<Button Grid.Column="1"
											x:Name="RP2040ExportButton"
											IsEnabled="False"
											Content="Export To RP2040!"
											ToolTip.Tip="Converts your image to a uf2 and copies it directly to a connected RP2040. Base firmware must be flashed first!"
											FontWeight="Bold"
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="ExportToDeviceButton_Click" />
								</Grid>
								<Button x:Name="RP2040ExportUF2Button"
										IsEnabled="False"
										Content="Export to .UF2"
										ToolTip.Tip="Converts your image to a .uf2 file for manual transfer. Use this if auto-detection doesn't find your device. This can also be used to prepare drawings ahead of time, and you can drag and drop the .uf2 onto the RPI-RP2 or RP2350 device once its done another image."
										FontWeight="Bold"
										HorizontalAlignment="Stretch"
										Margin="2,0,0,0"
										Click="ExportUF2Button_Click" />
							</StackPanel>
						</TabItem>
						<TabItem x:Name="RP2350Tab" Header="RP2350">
							<StackPanel Spacing="5" Margin="0,4,0,0">
								<TextBlock x:Name="RP2350StatusLabel" Text="RP2350: Not Found" />
								<Grid ColumnDefinitions="*,*">
									<Button Grid.Column="0"
											x:Name="RP2350FlashButton"
											IsEnabled="False"
											Content="Flash Base Firmware"
											ToolTip.Tip="Flash the firmware that reads drawing data from the RP2350's flash."
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="FlashFirmwareButton_Click" />
									<Button Grid.Column="1"
											x:Name="RP2350ExportButton"
											IsEnabled="False"
											Content="Export To RP2350!"
											ToolTip.Tip="Converts your image to a uf2 and copies it directly to a connected RP2350. Base firmware must be flashed first!"
											FontWeight="Bold"
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="ExportToDeviceButton_Click" />
								</Grid>
								<Button x:Name="RP2350ExportUF2Button"
										IsEnabled="False"
										Content="Export to .UF2"
										ToolTip.Tip="Converts your image to a .uf2 file for manual transfer. Use this if auto-detection doesn't find your device. This can also be used to prepare drawings ahead of time, and you can drag and drop the .uf2 onto the RPI-RP2 or RP2350 device once its done another image."
										FontWeight="Bold"
										HorizontalAlignment="Stretch"
										Margin="2,0,0,0"
										Click="ExportUF2Button_Click" />
							</StackPanel>
						</TabItem>
						<TabItem x:Name="ESP32S3Tab" Header="ESP32-S3">
							<StackPanel Spacing="5" Margin="0,4,0,0">
								<TextBlock x:Name="ESP32StatusLabel"
										   Text="ESP32-S3 Status: scanning..." />
								<Grid ColumnDefinitions="Auto,*">
									<TextBlock Grid.Column="0"
											   Text="Board:"
											   VerticalAlignment="Center"
											   Margin="2,0,4,0" />
									<ComboBox Grid.Column="1"
											  x:Name="ESP32BoardComboBox"
											  HorizontalAlignment="Stretch"
											  ToolTip.Tip="Picks which firmware variant to flash. The bundled firmware only differs per board for the onboard WS2812 LED GPIO - HID/controller behavior is identical, so the wrong pick just means the status LED won't blink."
											  SelectionChanged="ESP32BoardComboBox_SelectionChanged" />
								</Grid>
								<TextBlock Text="Picks which onboard LED GPIO the firmware drives. If the LED stays dark after flashing, pick a different board and reflash."
										   FontSize="11"
										   Foreground="Gray"
										   TextWrapping="Wrap"
										   Margin="2,0,2,2" />
								<Button Content="ESP32-S3 Setup Explanation"
										ToolTip.Tip="ESP32-specific BOOT-mode flashing notes and the single-port vs dual-port nuance. The generic Help menu items cover the Switch side."
										HorizontalAlignment="Stretch"
										Margin="2,0,0,0"
										Click="ESP32OutputExplanationButton_Click" />
								<Grid ColumnDefinitions="*,*">
									<Button Grid.Column="0"
											x:Name="FlashESP32FirmwareButton"
											IsEnabled="False"
											Content="Flash Base Firmware"
											ToolTip.Tip="Writes the bundled ESP32-S3 firmware (bootloader + partition table + app) to the detected board. Only needed once per board, or when updating to a new firmware version."
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="FlashESP32FirmwareButton_Click" />
									<Button Grid.Column="1"
											x:Name="RefreshESP32Button"
											Content="Re-scan COM Ports"
											ToolTip.Tip="Probe all serial ports for ESP32-S3 chips. Each probe briefly resets the board on that port - if the board is currently drawing on a Switch, leave it alone and skip the scan."
											HorizontalAlignment="Stretch"
											Margin="2,0,2,0"
											Click="RefreshESP32Button_Click" />
								</Grid>
								<Button x:Name="ExportESP32Button"
										IsEnabled="False"
										Content="Export To ESP32-S3!"
										ToolTip.Tip="Processes the drawing into a TDLD image and writes it to the ESP32-S3 board's tdld partition via esptool. Requires the base firmware to already be on the board."
										FontWeight="Bold"
										HorizontalAlignment="Stretch"
										Margin="2,0,0,0"
										Click="ExportESP32Button_Click" />
							</StackPanel>
						</TabItem>
					</TabControl>
				</Border>
			</Grid>

			<!-- PREVIEW -->

			<Border Grid.Column="1" Classes="group" Margin="0,0,6,0">
				<DockPanel>
					<TextBlock
					x:Name="PreviewHeader"
					DockPanel.Dock="Top"
					Classes="header"
					Text="Preview" />
					<Grid DockPanel.Dock="Top" Margin="0,0,0,6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0"
								   Text="Colour Matcher:"
								   VerticalAlignment="Center"
								   Margin="0,0,4,0" />
						<ComboBox Grid.Column="1"
								  x:Name="ColourMatcherComboBox"
								  HorizontalAlignment="Stretch"
								  Margin="0,0,8,0"
								  SelectionChanged="ColourMatcherComboBox_SelectionChanged" />
						<Button Grid.Column="2" Content="?"
								Margin="0,0,4,0"
								Click="ColourMatcherHelpButton_Click" />
						<TextBlock Grid.Column="3"
								   Text="Colour Limit:"
								   VerticalAlignment="Center"
								   Margin="0,0,4,0" />
						<!-- TODO: revert to NumericUpDown once Avalonia#21491 is fixed -->
							<local:SafeNumericUpDown Grid.Column="4"
									   x:Name="ColourLimitUpDown"
									   Minimum="1" Maximum="256"
									   Increment="1" Value="16"
									   FormatString="F0"
									   HorizontalAlignment="Stretch"
									   Margin="0,0,8,0"
									   IsEnabled="False"
									   ValueChanged="ColourLimitUpDown_ValueChanged"/>
						<TextBlock Grid.Column="5"
								   Text="Denoising:"
								   VerticalAlignment="Center"
								   Margin="0,0,4,0" />
						<ComboBox Grid.Column="6"
								  x:Name="DenoisingComboBox"
								  IsEnabled="True"
								  HorizontalAlignment="Stretch" />
					</Grid>
					<Image x:Name="PreviewImage"
						   Stretch="Uniform"
						   Source="avares://TomodachiDrawer.UI.Avalonia/Assets/NoImagePlaceholder.png"
						   RenderOptions.BitmapInterpolationMode="None" />
				</DockPanel>
			</Border>
		</Grid>

	</DockPanel>
</Window>
